*.synctex.gz

# MATLAB caches and reproducible generated output.
slprj/
*.slxc
*.asv
*.autosave
*_ert_rtw/
*_grt_rtw/
/sim/generated/
/sim/output/
# Do not blanket-ignore .slx, .mat, CSV, PNG, PDF or all .log files.
# Selected validated models and measurement logs need explicit provenance.

# Duplicated local design iterations and bulk browser captures.
/dashboard/_backup_v*/
/dashboard/artifacts/
/dashboard/.runtime/
/cn/logs/
/os/scratch/
# Keep one small, reviewed demo capture under docs/images/.

# Download/build dependencies from pinned URLs and hashes instead of vendoring caches.
/cn/third_party/ns-3.44/
# Retain existing licensed submodules only after dependency review.

# Compiler and downloaded application/render bundles.
**/swift-cache/
**/.swift-cache/
**/.swift-module-cache/
*.pcm
*.swiftmodule
**/tools/_build/
**/PROMPT*.md

# A measurement log named run*.log is still evidence; review its contents explicitly.
!**/results/**/run*.log

**/cache/
**/codegen/

/os/third_party/


# Raw UART captures are evidence, not compiled firmware.
!**/results/**/capture/uart.bin
*.pid

# study site build output
study-site/site/
