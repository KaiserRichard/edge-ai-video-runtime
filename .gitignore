# Proposed rules for a future monorepo. Review before applying.
# Keep raw measurements, their validity flags, and provenance manifests deliberately.

# Local credentials and host configuration; templates may be committed after review.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
.ssh/
.aws/

# Local assistant state and private working notes.
.claude/
.codex/
.agents/
.obsidian/
/conductor/
/PROMPT*.txt
/**/PROMPT*.txt
/**/run*.log
/**/WORK_LOG*.md
/**/prompts/
AGENTS.md
CLAUDE.md
# Public engineering guidance is in docs/ENGINEERING.md.
# Convert useful ticket/design content to docs before excluding the originals.

# Environments and caches.
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
Thumbs.db
.runtime/
node_modules/

# Build products; source, Makefiles and selected evidence remain tracked.
**/build/
**/cmake-cache/
**/CMakeFiles/
CMakeCache.txt
*.o
*.a
*.so
*.dylib
*.elf
*.bin
*.map
*.d
*.aux
*.fdb_latexmk
*.fls
*.nav
*.out
